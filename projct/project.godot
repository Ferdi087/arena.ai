[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Player"
3d_physics/layer_3="Furniture"
3d_physics/layer_4="Vehicle"
3d_physics/layer_5="Interaction"
3d_physics/layer_6="NPC"
3d_physics/layer_7="Decoration"
3d_physics/layer_8="Trigger"

[physics]

3d/physics_engine="Jolt Physics"
3d/default_gravity=14.0
3d/default_gravity_vector=Vector3(0, -1, 0)
common/physics_ticks_per_second=60

[rendering]

anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/use_taa=false
renderer/rendering_method="forward_plus"
textures/vram_compression/import_etc2_astc=true
2d/snap/snap_2d_transforms_to_pixel=false

[network]

limits/debugger/max_chars_per_second=32768
