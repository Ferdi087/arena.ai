; Engine configuration file.
; Umzugs-Chaos "HAUL-O-VERSE" – Godot 4.7 / Forward+ / Jolt Physics
;
; Manuell gepflegter Abschnitt "MIGRATION-NOTES":
;   - 3d/physics_engine="Jolt Physics": bleibt wie im Bestandsprojekt aktiv.
;   - default_gravity 14.0: bewusste Cartoon-Physik (schnellerer Fall =
;     "weighty comedy feel"). Physik-Schlüsselzahlen in res://data/definitions/.
;   - debug_collisions_hint=false: DebugTools schaltet zur Laufzeit um.
;   - physics_ticks_per_second=60: Grab-Solver ist auf 60 Hz ausgelegt.
;   - stretch=canvas_items/expand: UI skaliert 1:1 mit; 3D bleibt unabhängig.
;   - Alle Rendering-Qualitäts-Optionen werden NICHT hier hart gesetzt, sondern
;     zur Laufzeit von SettingsManager applied (kein Neustart nötig, siehe dort).

config_version=5

[application]

config/name="HAUL-O-VERSE"
config/description="Physics-based moving company sim: grab, haul, damage, deliver."
run/main_scene="res://scenes/menus/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.09, 0.1, 0.13, 1)

[autoload]

EventBus="*res://core/event_bus.gd"
Content="*res://data/content_database.gd"
Settings="*res://core/settings_manager.gd"
Saves="*res://core/save_manager.gd"
Game="*res://core/game_manager.gd"
Scenes="*res://core/scene_manager.gd"
GameInput="*res://core/input_manager.gd"
Sfx="*res://audio/audio_manager.gd"
Company="*res://gameplay/economy/company_service.gd"
Characters="*res://gameplay/character/character_service.gd"
Missions="*res://gameplay/mission/mission_service.gd"
Net="*res://multiplayer/network_manager.gd"
UI="*res://ui/ui_service.gd"
Dev="*res://core/debug_tools.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

